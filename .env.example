# ---------------------------------------------------------------------------
# STORM 12 WEATHER - environment configuration
# Copy to .env and edit. Never commit .env. No secret ever reaches the client:
# the browser only ever talks to this project's own /api backend.
# ---------------------------------------------------------------------------

# Backend HTTP port
PORT=8787

# NWS/NOAA require a descriptive User-Agent with a contact address.
# https://www.weather.gov/documentation/services-web-api
NWS_USER_AGENT="Storm12Weather/1.0 (contact@storm12weather.example)"

# Default station market shown before a viewer picks a location
DEFAULT_LAT=36.1627
DEFAULT_LON=-86.7816
DEFAULT_LOCATION_NAME="Nashville, TN"

# Two-letter state codes making up the station's coverage area (county search,
# severe weather center defaults, ticker markets).
# The station home NEXRAD. KOHX is Nashville (Old Hickory).
DEFAULT_RADAR_SITE=KOHX

# WSR-88D sites offered in radar pickers (wider than the alert area).
RADAR_STATES=TN,AL,KY,AR,NC,SC,GA

COVERAGE_STATES=TN,KY,AL

# Cities used by the on-air weather ticker (name:lat:lon, comma separated)
TICKER_MARKETS="Nashville:36.1627:-86.7816,Murfreesboro:35.8456:-86.3903,Franklin:35.9251:-86.8689,Clarksville:36.5298:-87.3595,Columbia:35.6151:-87.0353,Cookeville:36.1628:-85.5016,Bowling Green:36.9685:-86.4808,Huntsville:34.7304:-86.5861"

# Optional: HLS/DASH/YouTube-embed URL for the live weather stream.
# Leave blank and the Live Weather page automatically falls back to the newest
# NWS radar loop + latest forecast instead of showing a dead player.
LIVE_STREAM_URL=
LIVE_STREAM_TYPE=hls

# Optional: a lightning vector/tile endpoint if your station licenses one
# (e.g. a Vaisala/Earth Networks feed). Blank = layer reports "no feed".
LIGHTNING_TILE_URL=
LIGHTNING_GEOJSON_URL=

# Optional sponsor billboard shown in Broadcast Mode
SPONSOR_NAME=
SPONSOR_TAGLINE=

# Comma separated origins allowed to call the API (blank = same-origin only)
CORS_ORIGINS=http://localhost:5173

# Optional: a WMS GetMap template for Storm Relative Velocity. No free public
# NOAA service publishes SRV tiles; without this the SRV product reports
# "no feed configured" instead of rendering a dead layer.
SRV_WMS_URL=
SRV_WMS_LAYER=

# Newsroom admin panel (/admin). Leave blank to disable the panel entirely.
ADMIN_PASSWORD=
